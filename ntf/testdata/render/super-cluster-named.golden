=== c1_s1/config.cfg

include "snippets/top.conf"
server_name: "lon-n1"
port: <PORT1>

client_advertise: "localhost:<PORT2>"


log_file: "<INSTANCE_DIR>/c1_s1/server.log"





cluster {
	name: "lon"
	port: <PORT3>
	advertise: "127.0.0.1:<PORT4>"
	routes: [

"nats://localhost:<PORT3>"

"nats://127.0.0.1:<PORT5>"

"nats://127.0.0.1:<PORT6>"

	]
}



gateway {
	name: "lon"
	port: <PORT7>
	advertise: "127.0.0.1:<PORT4>"
	gateways: [

		{ name: "c3", urls: [
		"nats://127.0.0.1:<PORT8>"
]}

		{ name: "lon", urls: [
		"nats://localhost:<PORT7>"

		"nats://localhost:<PORT9>"

		"nats://localhost:<PORT10>"
]}

		{ name: "nyc", urls: [
		"nats://127.0.0.1:<PORT11>"

		"nats://127.0.0.1:<PORT12>"
]}

	]
}








system_account: "$SYS"
no_auth_user: user1

accounts {
	USERS1 {
		users = [ { user: "user1", pass: "password" } ]
		jetstream: false
	}
	USERS2 {
		users = [ { user: "user2", pass: "password" } ]
		jetstream: false
	}
	USERS3 {
		users = [ { user: "user3", pass: "password" } ]
		jetstream: false
	}
	USERS4 {
		users = [ { user: "user4", pass: "password" } ]
		jetstream: false
	}
	USERS5 {
		users = [ { user: "user5", pass: "password" } ]
		jetstream: false
	}
	$SYS { users = [ { user: "system", pass: "password" } ] }
}
