=== c1_s1/config.cfg


server_name: "<SHORT>-c1_s1"
port: <PORT1>

client_advertise: "localhost:<PORT2>"


log_file: "<INSTANCE_DIR>/c1_s1/server.log"





cluster {
	name: "SC_<SHORT>_1"
	port: <PORT3>
	advertise: "127.0.0.1:<PORT4>"
	routes: [

"nats://localhost:<PORT3>"

"nats://127.0.0.1:<PORT5>"

	]
}



gateway {
	name: "SC_<SHORT>_1"
	port: <PORT6>
	advertise: "127.0.0.1:<PORT4>"
	gateways: [

		{ name: "SC_<SHORT>_1", urls: [
		"nats://localhost:<PORT6>"

		"nats://localhost:<PORT7>"
]}

		{ name: "SC_<SHORT>_2", urls: [
		"nats://127.0.0.1:<PORT8>"

		"nats://127.0.0.1:<PORT9>"
]}

	]
}








system_account: "$SYS"
no_auth_user: user1

accounts {
	USERS1 {
		users = [ { user: "user1", pass: "password" } ]
		jetstream: false
	}
	USERS2 {
		users = [ { user: "user2", pass: "password" } ]
		jetstream: false
	}
	USERS3 {
		users = [ { user: "user3", pass: "password" } ]
		jetstream: false
	}
	USERS4 {
		users = [ { user: "user4", pass: "password" } ]
		jetstream: false
	}
	USERS5 {
		users = [ { user: "user5", pass: "password" } ]
		jetstream: false
	}
	$SYS { users = [ { user: "system", pass: "password" } ] }
}
