{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/synadia-io/orbit.go/main/ntf/api/schemas/ntf/tester/v1/list_response.json",
  "properties": {
    "type": {
      "type": "string",
      "const": "io.synadia.ntf.tester.v1.list_response",
      "description": "The type id of the response"
    },
    "instances": {
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "The instance id"
          },
          "description": {
            "type": "string",
            "description": "The description of the instance"
          },
          "kind": {
            "type": "string",
            "description": "The kind of instance, server, cluster or super-cluster"
          },
          "cluster": {
            "type": "string",
            "description": "The cluster name of a cluster instance"
          },
          "servers": {
            "type": "integer",
            "description": "The number of servers in the instance"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When the instance was created"
          },
          "jetstream": {
            "type": "boolean",
            "description": "Whether the instance was created with JetStream"
          },
          "trace": {
            "type": "boolean",
            "description": "Whether the instance was created with trace, which implies a proxy"
          },
          "proxy": {
            "type": "boolean",
            "description": "Whether the instance was created with a proxy and no trace"
          },
          "toxics": {
            "type": "boolean",
            "description": "Whether the instance was created with toxics"
          }
        },
        "type": "object"
      },
      "type": "array",
      "description": "Every instance"
    }
  },
  "type": "object",
  "title": "io.synadia.ntf.tester.v1.list_response"
}
