        },
        "type": {
          "type": "string",
          "description": "The toxic's type"
        },
        "attributes": {
          "additionalProperties": true,
          "type": "object",
          "description": "The attributes of the toxic's type"
        },
        "toxicity": {
          "type": "number",
          "description": "The chance in [0, 1] that the toxic acts, 1 when absent"
