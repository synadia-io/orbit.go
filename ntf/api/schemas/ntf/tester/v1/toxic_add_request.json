                  "delay": {
                    "type": "integer",
                    "maximum": 60000000,
                    "minimum": 0,
                    "description": "How long apart the pieces are sent. Measured in microseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "average_size"
                ]
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slow_close"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "properties": {
                  "delay": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long the close of a connection is delayed. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeout"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "properties": {
                  "timeout": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long data is dropped before the connection is closed, never closed when 0. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The toxic's name, unique on the instance"
        },
        "selector": {
          "properties": {
            "kind": {
