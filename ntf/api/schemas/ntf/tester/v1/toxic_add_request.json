                  "jitter": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How much the delay varies either way. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "limit_data"
              }
            },
            "required": [
              "type"
            ]
