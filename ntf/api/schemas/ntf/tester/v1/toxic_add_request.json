      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "bandwidth"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "properties": {
                  "rate": {
                    "type": "integer",
                    "maximum": 1000000000,
                    "minimum": 1,
                    "description": "The most data passed each second. Measured in kilobytes per second."
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "rate"
                ]
              }
            },
            "required": [
              "attributes"
