                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "loss"
                ]
              }
            },
            "required": [
              "attributes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reset_peer"
