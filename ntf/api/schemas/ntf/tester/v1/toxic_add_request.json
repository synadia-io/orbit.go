          "then": {
            "properties": {
              "attributes": {
                "properties": {
                  "timeout": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long after data arrives the connection is reset. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slicer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
