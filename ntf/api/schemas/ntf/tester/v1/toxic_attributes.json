{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/synadia-io/orbit.go/main/ntf/api/schemas/ntf/tester/v1/toxic_attributes.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "bandwidth"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "properties": {
              "rate": {
                "type": "integer",
                "maximum": 1000000000,
                "minimum": 1,
                "description": "The most data passed each second. Measured in kilobytes per second."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "rate"
            ]
          }
        },
        "required": [
          "attributes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cut"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {},
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "latency"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "latency": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long data is delayed. Measured in milliseconds.",
                    "default": 0
                  },
                  "jitter": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How much the delay varies either way. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "limit_data"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "bytes": {
                    "type": "integer",
                    "maximum": 1125899906842624,
                    "minimum": 0,
                    "description": "How many bytes pass before the connection is closed. Measured in bytes.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "lossy"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "properties": {
              "loss": {
                "type": "number",
                "exclusiveMaximum": 1,
                "exclusiveMinimum": 0,
                "description": "The chance that a segment is lost."
              },
              "rto": {
                "type": "integer",
                "maximum": 86400000,
                "minimum": 1,
                "description": "How long a lost segment stalls the stream. Measured in milliseconds.",
                "default": 200
              },
              "max_rto": {
                "type": "integer",
                "maximum": 86400000,
                "minimum": 1,
                "description": "The longest stall of one retransmission, which doubles each time it is lost again. Measured in milliseconds.",
                "default": 3200
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "loss"
            ]
          }
        },
        "required": [
          "attributes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reset_peer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "timeout": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long after data arrives the connection is reset. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "slicer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "properties": {
              "average_size": {
                "type": "integer",
                "maximum": 1048576,
                "minimum": 1,
                "description": "The average size of a piece the data is cut into. Measured in bytes."
              },
              "size_variation": {
                "type": "integer",
                "maximum": 1048576,
                "minimum": 0,
                "description": "How much the size of a piece varies either way. Measured in bytes.",
                "default": 0
              },
              "delay": {
                "type": "integer",
                "maximum": 60000000,
                "minimum": 0,
                "description": "How long apart the pieces are sent. Measured in microseconds.",
                "default": 0
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "average_size"
            ]
          }
        },
        "required": [
          "attributes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "slow_close"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "delay": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long the close of a connection is delayed. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "timeout"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "timeout": {
                    "type": "integer",
                    "maximum": 86400000,
                    "minimum": 0,
                    "description": "How long data is dropped before the connection is closed, never closed when 0. Measured in milliseconds.",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          }
        }
      }
    }
  ],
  "description": "The attributes each toxic type accepts, as one rule on the type and attributes of a toxic for each type"
}
